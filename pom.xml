<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>ru.opash.web</groupId>
  <artifactId>lab4-webapp</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>war</packaging>
  <name>Лабораторная работа 4 — Опаш А.Б., 4314</name>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
  </properties>
  <dependencies>
    <!-- API используется при компиляции, а при запуске его предоставляет Tomcat. -->
    <dependency>
      <groupId>javax.servlet</groupId>
      <artifactId>javax.servlet-api</artifactId>
      <version>4.0.1</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
  <build>
    <finalName>lab4-webapp</finalName>
    <plugins>
      <!-- Компиляция исходных файлов Java. -->
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.8.0</version>
        <configuration><encoding>UTF-8</encoding></configuration>
      </plugin>
      <!-- Упаковка приложения в WAR для Tomcat. -->
      <plugin><artifactId>maven-war-plugin</artifactId><version>3.2.2</version></plugin>
      <!-- Создание документации из комментариев Javadoc. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.1.1</version>
        <configuration>
          <encoding>UTF-8</encoding><docencoding>UTF-8</docencoding><charset>UTF-8</charset>
          <show>protected</show><detectOfflineLinks>false</detectOfflineLinks>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
