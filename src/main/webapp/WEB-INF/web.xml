<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee https://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
  <display-name>Интернационализация списка книг</display-name>
  <servlet>
    <servlet-name>BooksList</servlet-name>
    <servlet-class>ru.opash.web.BooksList</servlet-class>
    <init-param>
      <param-name>defaultLanguage</param-name>
      <param-value>ru</param-value>
    </init-param>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet-mapping>
    <servlet-name>BooksList</servlet-name>
    <url-pattern>/BooksList</url-pattern>
  </servlet-mapping>
  <welcome-file-list><welcome-file>index.html</welcome-file></welcome-file-list>
</web-app>
